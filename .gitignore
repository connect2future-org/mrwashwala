# ==========================================
# Mr. WashWala Monorepo Root .gitignore
# ==========================================

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Secrets & Environment Variables (Keep examples)
.env
.env*.local
*.env
!.env.example
!*.env.example

# Node.js & Web (client/website & server)
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# Flutter & Dart (client/mobile)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
**/build/
coverage/
app.*.symbols
app.*.map.json
.widget_preview/

# Android Build & Artifacts
.gradle/
**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
local.properties
**/android/local.properties
*.keystore
*.jks

# iOS & macOS Build & Ephemeral
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/

# IDEs and Editors
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

